# Netlify cache headers
# Hashed static assets (JS, CSS, media) — safe to cache forever
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Root HTML — must revalidate so users get the latest build
/*
  Cache-Control: public, max-age=0, must-revalidate

# Fonts explicitly (if served from this origin in future)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
